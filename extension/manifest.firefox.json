{
  "manifest_version": 3,
  "name": "Finally that online downloader extension (FTODE)",
  "short_name": "FTODE",
  "version": "1.0.2",
  "browser_specific_settings": {
    "gecko": {
      "id": "ftode@maxakt.local",
      "strict_min_version": "109.0"
    }
  },
  "description": "High-performance media stream sniffer and video/audio downloader powered by native yt-dlp.",
  "author": "MaxAkt",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Finally that online downloader extension (FTODE)"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging",
    "webRequest",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
