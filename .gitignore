# ==========================================
# Max's Downloader - Git Ignore Rules
# ==========================================

# 1. Large Executables & Binaries (Auto-downloaded by host.py on setup)
native_host/bin/*.exe
native_host/bin/*.old
native_host/bin/*.tmp
native_host/bin/ffmpeg/
native_host/bin/*
!native_host/bin/.gitkeep

# 2. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# 3. Visual Studio & IDE Artifacts
.vs/
.vscode/
.idea/
*.sln.docstates
*.suo
*.user

# 4. OS & Temporary Files
Thumbs.db
Desktop.ini
.DS_Store
*.log
*.log.old
*.tmp
*.bak
cookies.txt

# 5. Build & Distribution Artifacts
dist/
release/
*.zip
*.crx
*.xpi
app.ico
Setup.exe
Uninstall.exe


